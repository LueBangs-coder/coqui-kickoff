{
  "name": "coqui-kickoff",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/create-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "privacy-check": "node scripts/check-public.mjs",
    "check": "npm run privacy-check && npm run test && npm run build",
    "deploy": "npm run check && wrangler pages deploy dist --project-name coqui-kickoff --branch main"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "lucide-react": "^0.468.0",
    "phaser": "^3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.8",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
